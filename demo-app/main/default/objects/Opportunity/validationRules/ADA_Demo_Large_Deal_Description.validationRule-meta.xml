<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ADA_Demo_Large_Deal_Description</fullName>
    <active>true</active>
    <description>Demo: deals over 100,000 need a description.</description>
    <errorConditionFormula
  >AND(Amount &gt; 100000, ISBLANK(Description))</errorConditionFormula>
    <errorDisplayField>Description</errorDisplayField>
    <errorMessage>Opportunities over 100,000 need a description.</errorMessage>
</ValidationRule>
