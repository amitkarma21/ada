<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <customErrors>
        <name>Escalated_Needs_High_Priority</name>
        <label>Escalated Needs High Priority</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <customErrorMessages>
            <errorMessage
      >Escalated cases must have High priority.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <description
  >Demo: blocks saving an escalated case that is not High priority.</description>
    <environments>Default</environments>
    <interviewLabel
  >ADA Demo Case Escalation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ADA Demo Case Escalation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Escalated_Needs_High_Priority</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsEscalated</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Priority</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
