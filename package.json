{
  "name": "ada",
  "private": true,
  "version": "0.1.0",
  "description": "ADA — Admin Deflection Agent (Salesforce managed package)",
  "scripts": {
    "lint": "eslint \"force-app/**/lwc/**/*.js\" \"demo-app/**/lwc/**/*.js\" --no-error-on-unmatched-pattern",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"force-app/**/*.{cls,trigger,js,html,css,json,xml}\" \"demo-app/**/*.{cls,trigger,js,html,css,json,xml}\" --no-error-on-unmatched-pattern",
    "verify:static": "bash scripts/verify.sh static",
    "verify:unit": "bash scripts/verify.sh unit",
    "verify:e2e": "bash scripts/verify.sh e2e"
  }
}
